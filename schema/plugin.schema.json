{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/les-cabochons/ajour-plugins-index/schema/plugin.schema.json",
  "title": "Ajour catalog plugin definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "author",
    "license",
    "website",
    "repository",
    "status",
    "compatibility",
    "capabilities",
    "features",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "author": {
      "$ref": "#/$defs/namedLink"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spdxId", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "spdxId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-.+]+$"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "website": {
      "$ref": "#/$defs/httpsUrl"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "slug", "url"],
      "properties": {
        "provider": {
          "const": "github"
        },
        "slug": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "status": {
      "enum": ["available", "coming-soon", "deprecated"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginApiVersion"],
      "properties": {
        "pluginApiVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["connector", "codeHost", "schema"]
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "allowPrereleases", "assetPattern"],
      "properties": {
        "method": {
          "const": "github-release"
        },
        "allowPrereleases": {
          "type": "boolean"
        },
        "assetPattern": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "thumbnail": {
          "$ref": "#/$defs/imagePath"
        },
        "hero": {
          "$ref": "#/$defs/imagePath"
        }
      }
    },
    "tags": {
      "$ref": "#/$defs/slugs"
    },
    "features": {
      "$ref": "#/$defs/slugs"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["install"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "coming-soon"
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "required": ["install"]
        }
      }
    }
  ],
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "namedLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "imagePath": {
      "type": "string",
      "pattern": "^(thumbnail|hero)\\.(png|jpe?g|webp|avif)$"
    },
    "slugs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
