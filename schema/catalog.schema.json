{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/les-cabochons/ajour-plugins-index/schema/catalog.schema.json",
  "title": "Ajour plugin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^plugins/[a-z0-9][a-z0-9_-]*/plugin\\.yaml$"
      }
    }
  }
}
